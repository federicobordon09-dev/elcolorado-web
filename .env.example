# Supabase — copy to .env.local and fill with your project's values.
# Dashboard -> Project Settings -> API (or Connect dialog -> Next.js framework).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret: legacy service_role key or new secret key. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
